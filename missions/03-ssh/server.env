# Mission 03 configuration.
#
# Instructors: fill in QUEST_SSH_HOST (and QUEST_SSH_USER if needed) to
# point students at a real SSH endpoint that prints a per-user token.
# Leave QUEST_SSH_HOST empty to run this mission in fallback mode, where
# SSH is self-reported and unverified instead of checked by CI.
#
# This is the only place SSH connection details should live.

QUEST_SSH_HOST=
QUEST_SSH_USER=quest
